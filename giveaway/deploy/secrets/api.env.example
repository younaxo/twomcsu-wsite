# Копировать в /srv/twomc-giveaway/secrets/api.env (права 0600, вне репозитория). Реальные значения в репозиторий не попадают.
# Пароли в DATABASE_URL и REDIS_PASSWORD должны совпадать с postgres.env и redis.env.
# Пароль БД генерировать из [A-Za-z0-9], иначе кодировать в DATABASE_URL (percent-encoding).
DATABASE_URL=postgresql://giveaway:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/giveaway?schema=public
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Розыгрыш ---
GIVEAWAY_ENABLED=true
# Генерирует ТОЛЬКО владелец (>= 32 байта, >= 16 различных). Агент значение не получает и не выводит.
GIVEAWAY_MASTER_SECRET=CHANGE_ME_OWNER_ONLY
GIVEAWAY_KEY_VERSION=1
GIVEAWAY_ALLOWED_SERVERS=anarchy-new-era
# Необязательные (есть значения по умолчанию в коде):
# GIVEAWAY_START_AT=
# GIVEAWAY_CUTOFF_AT=
# GIVEAWAY_THRESHOLD_MINUTES=
# GIVEAWAY_TIMESTAMP_WINDOW_S=300

# --- Обязательные в production ЗАГЛУШКИ: код их требует, розыгрышу они не нужны ---
# Каждая - СВОЯ случайная строка, сгенерированная на сервере; значения боевого twomc.su НЕ использовать.
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_STUB_1
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_STUB_2
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_RANDOM_STUB_3_AT_LEAST_32_CHARS
# Любая непустая строка (капча в этой выкладке не используется).
TURNSTILE_SECRET_KEY=giveaway-stub-unused
# Домен мини-выкладки (не localhost); cookie в этой выкладке не используются.
COOKIE_DOMAIN=giveaway.example.com
COOKIE_SECURE=true
