# twomc.su — переменные окружения (пример). Скопируйте в .env и заполните.
# Полное описание — docs/project/ENVIRONMENT.md (появится в PHASE 36),
# детали старого проекта (ориентир) — docs/technical/32-ENVIRONMENT.md.

# --- Общее ---
NODE_ENV=development
API_PORT=4000
# Порт web (Next.js) для docker-compose.prod.yml; reverse proxy смотрит на 127.0.0.1:WEB_PORT
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
TRUST_PROXY=false
# Срок хранения audit log по умолчанию (дней: 7/30/90/180/365); дальше —
# в админке «Система → Хранилище и журналы» (ADR-0084)
AUDIT_RETENTION_DAYS=90

# --- База данных ---
POSTGRES_USER=twomc
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=twomc
POSTGRES_PORT=5433
DATABASE_URL=postgresql://twomc:change_me_dev_only@localhost:5433/twomc
PRISMA_DEBUG=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_dev_only

# --- JWT / Auth ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Cloudflare Turnstile (anti-bot: вход, регистрация, восстановление пароля, формы) ---
# Dev: официальные тестовые ключи Cloudflare (виджет всегда проходит, Siteverify отвечает success).
# Production: реальные ключи из Cloudflare Dashboard; secret на frontend не попадает.
# Тестовый OTP регистрации (только development/test): 123456 — код принят,
# 000000 — гарантированный отказ. В production ДОЛЖНО быть false (иначе API
# не запустится).
AUTH_TEST_OTP_ENABLED=false

# TURNSTILE_DISABLED=true — только для автотестов без сети (CI e2e).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_DISABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Bootstrap-аккаунты (без них seed не создаёт #0/#1/#2, см. ADR-0006) ---
# Пароли — только здесь (dev: любой локальный, production: секрет из менеджера секретов).
# Без пароля аккаунт не создаётся; в production seed завершается ошибкой.
BOOTSTRAP_SYSTEM_PASSWORD=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_CHIEF_CURATOR_PASSWORD=
# Идентичность #1 (обязательна, без неё #1 пропускается) и #2 (по умолчанию younaxo_ / younaxo@icloud.com).
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_CHIEF_CURATOR_USERNAME=younaxo_
BOOTSTRAP_CHIEF_CURATOR_EMAIL=younaxo@icloud.com
# Alias входа для #2 (ADR-0061): у всех login = ник, у #2 дополнительно вход `younaxo`.
BOOTSTRAP_CHIEF_CURATOR_LOGIN_ALIAS=younaxo
# Уровень доступа (ADR-0062, 0…100) — отдельно от priority ролей; пусто = не менять.
BOOTSTRAP_OWNER_ACCESS_LEVEL=
BOOTSTRAP_CHIEF_CURATOR_ACCESS_LEVEL=

# --- CDN / файловое хранилище (см. ADR-0008, RISKS.md R3) ---
CDN_BASE_URL=http://localhost:4000/uploads
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
# Регион S3-совместимого хранилища (для российских провайдеров обычно ru-1)
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOADS_DIR=./uploads
UPLOAD_MAX_AVATAR_SIZE=5242880
UPLOAD_MAX_BANNER_SIZE=10485760

# --- Платежи (см. ADR-0009, RISKS.md R2) ---
PAYMENT_PROVIDER=test
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=dev-test-payment-webhook-secret

# --- SMTP (см. RISKS.md R4) ---
# Beget: smtp.beget.com:465 (SSL). Отправитель — noreply@twomc.su.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TwoMC
SMTP_FROM_EMAIL=
MAIL_FROM=noreply@twomc.su

# --- Web Push (см. RISKS.md R7) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@twomc.su

# --- Streaming (см. RISKS.md R6) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Публичный CDN статики (префиксы ролей и т.д.); физический путь на сервере
# во frontend не используется. Меняется только через конфигурацию.
NEXT_PUBLIC_CDN_BASE_URL=https://cdn-files.twomc.su

# --- Публичная оболочка сайта (shell) ---
# Соцсети Telegram/Discord/VK/YouTube редактируются в /admin/settings; env — fallback.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_VK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Официальный e-mail поддержки (fallback к contactEmail из настроек сайта)
NEXT_PUBLIC_SUPPORT_EMAIL=
# Публичная status page (отдельный проект); пусто — внутренний /status
NEXT_PUBLIC_STATUS_PAGE_URL=
# Юридические данные владельца для footer (только реальные, иначе блок скрыт)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_LEGAL_OGRNIP=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Build id для футера (подставляет CI/деплой)
NEXT_PUBLIC_BUILD_SHA=

# --- Вход через Discord / Telegram (ADR-0069) — только для уже привязанных аккаунтов ---
# Discord Developer Portal → OAuth2 → Redirects: https://api.twomc.su/auth/discord/callback
# (dev: http://localhost:4000/auth/discord/callback). Scope: identify.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback
# Telegram Login — OpenID Connect (ADR-0071): BotFather → бот → Login Widget →
# OpenID Connect; Allowed URLs: https://api.twomc.su/auth/telegram/callback.
# Client ID = id бота (если пусто — берётся из префикса TELEGRAM_BOT_TOKEN).
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:4000/auth/telegram/callback

# --- Minecraft-плагин: привязка аккаунта при регистрации (ADR-0072) ---
# Общий секрет подписи HMAC запросов плагина к /minecraft/plugin/* (≥ 32 символа).
# Пусто — интеграция выключена, шаг Minecraft в регистрации не требуется.
# Dev: pnpm --filter @twomc/api mc:plugin-sim connect <ник>
MINECRAFT_PLUGIN_SECRET=
# Видео-инструкции регистрации (YouTube / RuTube), пусто — кнопки скрыты.
NEXT_PUBLIC_TUTORIAL_YOUTUBE_URL=
NEXT_PUBLIC_TUTORIAL_RUTUBE_URL=

# --- Внешняя status page (независимая от основного origin) ---
# Сайт ведёт на неё, только когда задан NEXT_PUBLIC_STATUS_PAGE_URL (выше);
# пока status.twomc.su не развёрнут — пусто, кнопка ведёт на встроенный /status.
STATUS_PAGE_URL=https://status.twomc.su
