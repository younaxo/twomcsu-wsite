# Временный HTTP-блок для выпуска сертификата (webroot). Подстановка: envsubst '${STAND_DOMAIN}'.
server {
    listen 80;
    listen [::]:80;
    server_name ${STAND_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
