# Пример reverse proxy для twomc.su (nginx). Подставить реальные пути к
# сертификатам; если на сервере уже есть nginx/Caddy/панель — адаптировать,
# а не перезаписывать существующий конфиг.
#
# twomc.su      → web (Next.js, 127.0.0.1:3000)
# api.twomc.su  → api (NestJS, 127.0.0.1:4000), включая /socket.io (WebSocket)
# cdn-files.twomc.su остаётся отдельным файловым слоем — здесь не описывается.
#
# Клиентский IP (P3-02, ADR-0155): nginx — единственный доверенный хоп, поэтому
# X-Forwarded-For ПЕРЕЗАПИСЫВАЕТСЯ значением $remote_addr (а не дописывается
# к клиентскому заголовку), иначе клиент подставит произвольный IP. API
# запускается с TRUST_PROXY=1 (по умолчанию в docker-compose.prod.yml).
# Порт API/web публикуется только на 127.0.0.1; не открывать его наружу в обход nginx.
#
# Cloudflare перед nginx (топология не подтверждена): включать ТОЛЬКО если трафик
# идёт через Cloudflare, и закрыть origin файрволом, пропускающим на 80/443 лишь
# диапазоны Cloudflare. Тогда $remote_addr станет IP клиента через real_ip, а
# TRUST_PROXY остаётся 1 (хоп Cloudflare срезается модулем real_ip, не API).
# Актуальные диапазоны: https://www.cloudflare.com/ips/ (ips-v4 и ips-v6);
# при изменении списка обновить set_real_ip_from и выполнить `nginx -t && nginx -s reload`.
# Полный runbook (диапазоны, обновление, файрвол origin, проверки, откат): docs/runbooks/cloudflare-real-ip.md (ADR-0160).
#
# set_real_ip_from <CLOUDFLARE_IPV4_CIDR>;   # по одной строке на каждый диапазон
# set_real_ip_from <CLOUDFLARE_IPV6_CIDR>;
# real_ip_header CF-Connecting-IP;
# real_ip_recursive on;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name twomc.su www.twomc.su api.twomc.su;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name twomc.su www.twomc.su;

    ssl_certificate     /etc/letsencrypt/live/twomc.su/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/twomc.su/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl http2;
    server_name api.twomc.su;

    ssl_certificate     /etc/letsencrypt/live/twomc.su/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/twomc.su/privkey.pem;

    client_max_body_size 20m;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
