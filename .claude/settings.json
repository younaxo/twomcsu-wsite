{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(C:/Users/younaxo/.twomc/secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(C:/Users/younaxo/.twomc/secrets/**)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(vercel *)",
      "Bash(kubectl apply *)",
      "Bash(terraform apply *)",
      "Bash(pnpm *db:migrate*)",
      "Bash(pnpm *db:seed*)",
      "Bash(npx prisma migrate *)",
      "Bash(pnpm prisma migrate *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(vercel *)",
      "PowerShell(kubectl apply *)",
      "PowerShell(terraform apply *)",
      "PowerShell(pnpm *db:migrate*)",
      "PowerShell(pnpm *db:seed*)",
      "PowerShell(npx prisma migrate *)",
      "PowerShell(pnpm prisma migrate *)"
    ]
  }
}
